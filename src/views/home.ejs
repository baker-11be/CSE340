<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
        <img
            class="hero-image"
            src="/images/community-volunteers.jpg"
            alt="Community volunteers working together on a service project"
            fetchpriority="high">
        <div class="hero-shade"></div>
        <div class="hero-content">
            <p class="eyebrow hero-eyebrow">Good things happen when we serve together</p>
            <h1 id="hero-title">Make a difference,<br>right where you are.</h1>
            <p class="hero-description">BakerSERVE connects you with local ways to share your time and make your community stronger.</p>
            <a class="button button-primary" href="/projects">Find a project <span aria-hidden="true">→</span></a>
        </div>
        <a class="hero-scroll" href="#opportunities">Explore opportunities <span aria-hidden="true">↓</span></a>
    </section>

    <section class="intro-section content-width" id="welcome">
        <div>
            <p class="eyebrow">A little good goes a long way</p>
            <h2>There is a place for everyone to serve.</h2>
        </div>
        <p>BakerSERVE brings volunteers and local organizations together. Whether you have an hour or a whole afternoon, find a meaningful way to help neighbors and build a more connected community.</p>
    </section>

    <section class="about-section" id="about">
        <div class="content-width about-content">
            <div>
                <p class="eyebrow">About BakerSERVE</p>
                <h2>Small acts of service can make a community stronger.</h2>
            </div>
            <div class="about-copy">
                <p>BakerSERVE helps local organizations share their volunteer needs and makes it easier for people to find ways to contribute.</p>
                <p>Everyone deserves the opportunity to serve and feel welcome. Explore local partners, choose a cause that matters to you, and take the first step.</p>
                <a class="text-link" href="/organizations">Meet our organizations <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>

    <section class="section section-muted" id="opportunities">
        <div class="content-width">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Get started</p>
                    <h2>Find your next way to help</h2>
                </div>
                <a class="text-link" href="/projects">See all projects <span aria-hidden="true">→</span></a>
            </div>
            <div class="card-grid">
                <article class="opportunity-card">
                    <div class="card-icon icon-teal" aria-hidden="true">♡</div>
                    <p class="card-category">Care &amp; connection</p>
                    <h3>Brighten a neighbor’s day</h3>
                    <p>Share a friendly visit and lend a hand to older adults in your community.</p>
                    <a href="/projects" class="card-link">Explore this project <span aria-hidden="true">→</span></a>
                </article>
                <article class="opportunity-card">
                    <div class="card-icon icon-orange" aria-hidden="true">✳</div>
                    <p class="card-category">Food &amp; essentials</p>
                    <h3>Pack a little more hope</h3>
                    <p>Help prepare food boxes and get everyday essentials to local families.</p>
                    <a href="/projects" class="card-link">Explore this project <span aria-hidden="true">→</span></a>
                </article>
                <article class="opportunity-card">
                    <div class="card-icon icon-green" aria-hidden="true">✿</div>
                    <p class="card-category">Neighborhood</p>
                    <h3>Grow a greener community</h3>
                    <p>Join neighbors to care for shared spaces, parks, and community gardens.</p>
                    <a href="/projects" class="card-link">Explore this project <span aria-hidden="true">→</span></a>
                </article>
            </div>
        </div>
    </section>

    <section class="story-section content-width" id="stories">
        <div class="story-mark" aria-hidden="true">“</div>
        <div>
            <p class="eyebrow">Success stories</p>
            <h2 class="story-heading">The difference is us</h2>
            <blockquote>“We came to help for an afternoon. We left feeling like we belonged.”</blockquote>
            <p class="story-credit">A community volunteer</p>
        </div>
    </section>

    <section class="join-section" id="get-involved">
        <div class="content-width join-content">
            <div>
                <p class="eyebrow">Your community is calling</p>
                <h2>Bring your good to the neighborhood.</h2>
                <p>Find a project, meet the people behind it, and make your first day of service count.</p>
            </div>
            <a class="button button-light" href="/organizations">Meet our organizations <span aria-hidden="true">→</span></a>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
