<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="page-hero">
        <div class="content-width">
            <p class="eyebrow">Find your kind of service</p>
            <h1>Many ways to<br>make a difference.</h1>
            <p>Explore service project categories and find a cause that matters to you.</p>
        </div>
    </section>
    <section class="section section-muted">
        <div class="content-width">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Explore opportunities</p>
                    <h2>Service project categories</h2>
                </div>
                <a class="text-link" href="/projects">See all projects <span aria-hidden="true">→</span></a>
            </div>
            <div class="category-grid">
                <article class="category-card">
                    <span class="category-number" aria-hidden="true">01</span>
                    <h3>Environmental</h3>
                </article>
                <article class="category-card">
                    <span class="category-number category-number-orange" aria-hidden="true">02</span>
                    <h3>Educational</h3>
                </article>
                <article class="category-card">
                    <span class="category-number category-number-green" aria-hidden="true">03</span>
                    <h3>Community Service</h3>
                </article>
                <article class="category-card">
                    <span class="category-number category-number-gold" aria-hidden="true">04</span>
                    <h3>Health and Wellness</h3>
                </article>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
