<%- include('partials/header', { title }) %>
<% const categoryDescriptions = {
    'Environmental': 'Care for parks, gardens, and natural spaces in your neighborhood.',
    'Educational': 'Help learners build skills, confidence, and opportunities for the future.',
    'Community Service': 'Lend a hand to local projects that bring neighbors together.',
    'Health and Wellness': 'Support the wellbeing and connection of people in your community.'
}; %>
<main id="main-content">
    <section class="discovery-hero discovery-hero-compact">
        <div class="content-width">
            <p class="eyebrow">Find your kind of service</p>
            <h1>Explore Categories</h1>
            <p>Choose a cause that matters to you and discover local projects where you can make a difference.</p>
        </div>
    </section>
    <section class="directory-section" aria-labelledby="category-results-title">
        <div class="content-width">
            <div class="directory-heading">
                <div>
                    <p class="eyebrow">Causes in your community</p>
                    <h2 id="category-results-title">Service project categories</h2>
                </div>
                <a class="text-link" href="/projects">Explore all projects <span aria-hidden="true">→</span></a>
            </div>
            <div class="category-grid">
                <% if (categories.length > 0) { %>
                    <% categories.forEach((category, index) => { %>
                        <a class="category-card" href="/projects?category=<%= encodeURIComponent(category.name) %>">
                            <span class="category-number <%= ['', 'category-number-orange', 'category-number-green', 'category-number-gold'][index % 4] %>" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                            <span class="category-card-copy">
                                <span class="category-card-title"><%= category.name %></span>
                                <span class="category-card-description"><%= categoryDescriptions[category.name] || 'Explore local projects and find a meaningful way to contribute.' %></span>
                                <span class="category-card-link">View related projects <span aria-hidden="true">→</span></span>
                            </span>
                        </a>
                    <% }); %>
                <% } else { %>
                    <p>No service project categories are available right now.</p>
                <% } %>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
