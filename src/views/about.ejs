<%- include('partials/header', { title }) %>
<main id="main-content">
    <div class="page-photo-banner">
        <img src="/images/community-volunteers.jpg" alt="Volunteers working together on a community project">
    </div>
    <section class="page-hero">
        <div class="content-width">
            <p class="eyebrow">About BakerSERVE</p>
            <h1>About Us</h1>
            <p>At BakerSERVE, we believe small acts of service can make a community stronger.</p>
        </div>
    </section>
    <section class="about-section">
        <div class="content-width about-content">
            <div>
                <p class="eyebrow">A place for everyone</p>
                <h2>Bring neighbors and local organizations together.</h2>
            </div>
            <div class="about-copy">
                <p>BakerSERVE helps local organizations share their volunteer needs and makes it easier for people to find ways to contribute.</p>
                <p>Everyone deserves the opportunity to serve and feel welcome. Explore local partners, choose a cause that matters to you, and take the first step.</p>
                <a class="text-link" href="/organizations">Meet our organizations <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>
    <section class="join-section">
        <div class="content-width join-content">
            <div>
                <p class="eyebrow">Your community is calling</p>
                <h2>Find a way to make a difference.</h2>
                <p>Explore local projects and meet the organizations making them possible.</p>
            </div>
            <a class="button button-light" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
