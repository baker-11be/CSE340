<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="discovery-hero">
        <div class="content-width">
            <p class="eyebrow">Community partner</p>
            <h1><%= organization.name %></h1>
            <p><%= organization.description %></p>
        </div>
    </section>

    <section class="directory-section" aria-labelledby="organization-details-title">
        <div class="content-width">
            <div class="entity-detail">
                <img class="organization-logo" src="/images/<%= organization.logo_filename %>" alt="" width="60" height="60">
                <h2 id="organization-details-title">About this organization</h2>
                <p><%= organization.description %></p>
                <p><a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
            </div>

            <div class="directory-heading">
                <div>
                    <p class="eyebrow">Get involved</p>
                    <h2>Projects with <%= organization.name %></h2>
                </div>
            </div>
            <% if (projects.length > 0) { %>
                <div class="project-list">
                    <% projects.forEach(project => { %>
                        <article class="project-card">
                            <div class="project-details">
                                <p class="card-category"><%= project.category_names || 'Community service' %></p>
                                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                                <p><%= project.description %></p>
                                <div class="project-meta">
                                    <span><%= project.project_date_display %></span>
                                    <span><%= project.location %></span>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <h3>No projects are listed for this organization yet.</h3>
                    <a class="text-link" href="/projects">Browse upcoming projects <span aria-hidden="true">→</span></a>
                </div>
            <% } %>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
