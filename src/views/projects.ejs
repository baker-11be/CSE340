<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="discovery-hero discovery-hero-compact">
        <div class="content-width">
            <p class="eyebrow">Make your time matter</p>
            <h1>Find a Project</h1>
            <p>Explore local service opportunities and find a meaningful way to help your community.</p>
        </div>
    </section>

    <section class="project-explorer" aria-label="Search and browse service projects">
        <div class="content-width project-explorer-layout">
            <aside class="project-filters" aria-labelledby="filter-title">
                <h2 id="filter-title">Filter projects</h2>
                <form action="/projects" method="get">
                    <div class="filter-field">
                        <label for="project-search">Keyword</label>
                        <input id="project-search" name="search" type="search" placeholder="Project, organization, or place" value="<%= searchTerm %>">
                    </div>
                    <div class="filter-field">
                        <label for="project-category">Category</label>
                        <select id="project-category" name="category">
                            <option value="">All categories</option>
                            <% categories.forEach(category => { %>
                                <option value="<%= category.name %>" <% if (selectedCategory === category.name) { %>selected<% } %>><%= category.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button class="button button-primary filter-submit" type="submit">Apply filters</button>
                    <% if (searchTerm || selectedCategory) { %>
                        <a class="clear-filters" href="/projects">Clear filters</a>
                    <% } %>
                </form>
            </aside>

            <div class="project-results" aria-labelledby="project-results-title">
                <div class="project-results-heading">
                    <div>
                        <p class="eyebrow"><%= searchTerm || selectedCategory ? 'Search results' : 'Ways to serve' %></p>
                        <h2 id="project-results-title"><%= searchTerm || selectedCategory ? 'Projects that match your search' : 'Upcoming service projects' %></h2>
                    </div>
                    <p class="results-note"><%= projects.length %> projects</p>
                </div>

                <% if (projects.length > 0) { %>
                    <div class="project-list">
                        <% projects.forEach((project, index) => { %>
                            <article class="project-card">
                                <div class="project-symbol project-symbol-<%= ['teal', 'orange', 'green'][index % 3] %>" aria-hidden="true"><%= ['✿', '♡', '✳'][index % 3] %></div>
                                <div class="project-details">
                                    <p class="card-category"><%= project.category_names || 'Community service' %></p>
                                    <h3><%= project.title %></h3>
                                    <p><%= project.description %></p>
                                    <div class="project-meta">
                                        <span><%= project.project_date_display %></span>
                                        <span><%= project.location %></span>
                                        <span>With <%= project.organization_name %></span>
                                    </div>
                                </div>
                                <a class="button button-outline" href="mailto:<%= project.organization_contact_email %>?subject=<%= encodeURIComponent(project.title) %>">Get involved <span aria-hidden="true">→</span></a>
                            </article>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <h3>No projects match these filters.</h3>
                        <p>Try another keyword or category to explore more ways to serve.</p>
                        <a class="text-link" href="/projects">Browse all projects <span aria-hidden="true">→</span></a>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
