<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="page-hero">
        <div class="content-width">
            <p class="eyebrow">Make your time matter</p>
            <h1>Good things are<br>happening nearby.</h1>
            <p>Find a hands-on way to help and make a difference alongside your neighbors.</p>
        </div>
    </section>
    <section class="section section-muted">
        <div class="content-width">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Ways to serve</p>
                    <h2>Upcoming service projects</h2>
                </div>
                <span class="results-note"><%= projects.length %> community opportunities</span>
            </div>
            <div class="project-list">
                <% if (projects.length > 0) { %>
                    <% projects.forEach((project, index) => { %>
                        <article class="project-card">
                            <div class="project-symbol project-symbol-<%= ['teal', 'orange', 'green'][index % 3] %>" aria-hidden="true"><%= ['✿', '♡', '✳'][index % 3] %></div>
                            <div class="project-details">
                                <p class="card-category"><%= project.category_names || 'Community service' %></p>
                                <h3><%= project.project_date_display %>: <%= project.title %> <em>(<%= project.organization_name %>)</em></h3>
                                <p><%= project.description %></p>
                                <div class="project-meta"><span>Location: <%= project.location %></span></div>
                            </div>
                            <a class="button button-outline" href="mailto:<%= project.organization_contact_email %>?subject=<%= encodeURIComponent(project.title) %>">Get involved <span aria-hidden="true">→</span></a>
                        </article>
                    <% }); %>
                <% } else { %>
                    <p>No service projects are available right now.</p>
                <% } %>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
