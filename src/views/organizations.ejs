<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="discovery-hero">
        <div class="content-width">
            <p class="eyebrow">Good work starts with good people</p>
            <h1>Find an Organization</h1>
            <p>At BakerSERVE, we believe community service brings people together. Search below to find local organizations and discover where your time can make a difference.</p>
            <form class="discovery-search" action="/organizations" method="get" role="search">
                <label class="visually-hidden" for="organization-search">Search organizations by keyword</label>
                <input id="organization-search" name="search" type="search" placeholder="Search by keyword" value="<%= searchTerm %>">
                <button class="button button-primary" type="submit">Search</button>
            </form>
        </div>
    </section>

    <section class="directory-section" aria-labelledby="organization-results-title">
        <div class="content-width">
            <div class="directory-heading">
                <div>
                    <p class="eyebrow">Local community partners</p>
                    <h2 id="organization-results-title">Organizations making a difference</h2>
                </div>
                <p class="results-note"><%= organizations.length %> organizations</p>
            </div>

            <% if (organizations.length > 0) { %>
                <div class="organization-grid">
                    <% organizations.forEach(organization => { %>
                        <article class="organization-card">
                            <img class="organization-logo" src="/images/<%= organization.logo_filename %>" alt="" width="60" height="60">
                            <div>
                                <p class="card-category">Community partner</p>
                                <h3><%= organization.name %></h3>
                                <p><%= organization.description %></p>
                                <a class="card-link" href="mailto:<%= organization.contact_email %>">Contact organization <span aria-hidden="true">↗</span></a>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <h3>No organizations match that search.</h3>
                    <p>Try a different keyword to discover more community partners.</p>
                    <a class="text-link" href="/organizations">View all organizations <span aria-hidden="true">→</span></a>
                </div>
            <% } %>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
