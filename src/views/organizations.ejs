<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="page-hero">
        <div class="content-width">
            <p class="eyebrow">Good work starts with good people</p>
            <h1>Meet the organizations<br>making a difference.</h1>
            <p>Get to know the local teams creating more caring, connected communities.</p>
        </div>
    </section>
    <section class="section">
        <div class="content-width">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Our community partners</p>
                    <h2>Find a cause that feels like you</h2>
                </div>
                <a class="text-link" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
            </div>
            <div class="organization-grid">
                <% organizations.forEach(organization => { %>
                    <article class="organization-card">
                        <img class="organization-logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                        <div>
                            <p class="card-category">Community partner</p>
                            <h3><%= organization.name %></h3>
                            <p><%= organization.description %></p>
                            <a class="card-link" href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %> <span aria-hidden="true">↗</span></a>
                        </div>
                    </article>
                <% }); %>
            </div>
        </div>
    </section>
    <section class="join-section">
        <div class="content-width join-content">
            <div>
                <p class="eyebrow">Ready to jump in?</p>
                <h2>There’s a project with your name on it.</h2>
            </div>
            <a class="button button-light" href="/projects">Find a project <span aria-hidden="true">→</span></a>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
