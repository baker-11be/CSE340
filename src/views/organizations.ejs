<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="page-hero">
        <div class="content-width">
            <p class="eyebrow">Good work starts with good people</p>
            <h1>Meet the organizations<br>making a difference.</h1>
            <p>Get to know the local teams creating more caring, connected communities.</p>
        </div>
    </section>
    <section class="section">
        <div class="content-width">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Our community partners</p>
                    <h2>Find a cause that feels like you</h2>
                </div>
                <a class="text-link" href="/projects">Explore projects <span aria-hidden="true">→</span></a>
            </div>
            <div class="organization-grid">
                <article class="organization-card">
                    <img class="organization-logo" src="/images/brightfuture-logo.svg" alt="" aria-hidden="true">
                    <div>
                        <p class="card-category">Youth &amp; education</p>
                        <h3>BrightFuture Builders</h3>
                        <p>Helping young people discover their strengths through mentoring, learning, and community support.</p>
                        <a class="card-link" href="mailto:info@brightfuture.org">info@brightfuture.org <span aria-hidden="true">↗</span></a>
                    </div>
                </article>
                <article class="organization-card">
                    <img class="organization-logo" src="/images/greenharvest-logo.svg" alt="" aria-hidden="true">
                    <div>
                        <p class="card-category">Food &amp; environment</p>
                        <h3>GreenHarvest Growers</h3>
                        <p>Growing fresh food and bringing neighbors together to care for shared green spaces.</p>
                        <a class="card-link" href="mailto:contact@greenharvest.org">contact@greenharvest.org <span aria-hidden="true">↗</span></a>
                    </div>
                </article>
                <article class="organization-card">
                    <img class="organization-logo" src="/images/unityserve-logo.svg" alt="" aria-hidden="true">
                    <div>
                        <p class="card-category">Community care</p>
                        <h3>UnityServe Volunteers</h3>
                        <p>Connecting caring people with practical ways to support families and neighbors.</p>
                        <a class="card-link" href="mailto:hello@unityserve.org">hello@unityserve.org <span aria-hidden="true">↗</span></a>
                    </div>
                </article>
            </div>
        </div>
    </section>
    <section class="join-section">
        <div class="content-width join-content">
            <div>
                <p class="eyebrow">Ready to jump in?</p>
                <h2>There’s a project with your name on it.</h2>
            </div>
            <a class="button button-light" href="/projects">Find a project <span aria-hidden="true">→</span></a>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
