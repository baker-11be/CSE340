<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="discovery-hero">
        <div class="content-width">
            <p class="eyebrow">Service project details</p>
            <h1><%= project.title %></h1>
            <p><%= project.description %></p>
        </div>
    </section>

    <section class="directory-section" aria-labelledby="project-details-title">
        <div class="content-width">
            <div class="entity-detail">
                <h2 id="project-details-title">Project information</h2>
                <dl class="detail-list">
                    <div>
                        <dt>Date</dt>
                        <dd><%= project.date %></dd>
                    </div>
                    <div>
                        <dt>Location</dt>
                        <dd><%= project.location %></dd>
                    </div>
                    <div>
                        <dt>Partner organization</dt>
                        <dd><a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></dd>
                    </div>
                </dl>
                <h2>Categories</h2>
                <% if (categories.length > 0) { %>
                    <ul class="category-tags" aria-label="Project categories">
                        <% categories.forEach(category => { %>
                            <li><a class="category-tag" href="/category/<%= category.category_id %>"><%= category.name %></a></li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p>No categories are assigned to this project yet.</p>
                <% } %>
                <a class="text-link" href="/projects">Browse upcoming projects <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
