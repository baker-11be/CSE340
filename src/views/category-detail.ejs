<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="discovery-hero discovery-hero-compact">
        <div class="content-width">
            <p class="eyebrow">Service project category</p>
            <h1><%= category.name %></h1>
            <p>Explore service projects connected to this cause and find a meaningful way to contribute.</p>
        </div>
    </section>

    <section class="directory-section" aria-labelledby="category-projects-title">
        <div class="content-width">
            <div class="directory-heading">
                <div>
                    <p class="eyebrow">Ways to make a difference</p>
                    <h2 id="category-projects-title">Projects in <%= category.name %></h2>
                </div>
                <a class="text-link" href="/categories">All categories <span aria-hidden="true">→</span></a>
            </div>

            <% if (projects.length > 0) { %>
                <div class="project-list">
                    <% projects.forEach(project => { %>
                        <article class="project-card">
                            <div class="project-details">
                                <p class="card-category"><%= project.category_names %></p>
                                <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                                <p><%= project.description %></p>
                                <div class="project-meta">
                                    <span><%= project.project_date_display %></span>
                                    <span><%= project.location %></span>
                                    <span>With <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></span>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <h3>No projects are listed in this category yet.</h3>
                    <a class="text-link" href="/projects">Browse upcoming projects <span aria-hidden="true">→</span></a>
                </div>
            <% } %>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
