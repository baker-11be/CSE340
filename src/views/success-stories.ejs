<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="discovery-hero">
        <div class="content-width">
            <p class="eyebrow">Success stories</p>
            <h1>Small acts can change a community.</h1>
            <p>At BakerSERVE, we believe volunteerism brings people together. Here is a reminder of what can happen when we show up for one another.</p>
        </div>
    </section>
    <section class="story-section content-width" aria-labelledby="story-title">
        <div class="story-mark" aria-hidden="true">“</div>
        <div>
            <p class="eyebrow">A community volunteer</p>
            <h2 class="story-heading" id="story-title">The difference is us</h2>
            <blockquote>“We came to help for an afternoon. We left feeling like we belonged.”</blockquote>
            <p class="story-credit">A community volunteer</p>
        </div>
    </section>
    <section class="join-section">
        <div class="content-width join-content">
            <div>
                <p class="eyebrow">Be part of the next story</p>
                <h2>Find a project in your community.</h2>
                <p>Take the first step and discover a local way to help.</p>
            </div>
            <a class="button button-light" href="/projects">Find a project <span aria-hidden="true">→</span></a>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
