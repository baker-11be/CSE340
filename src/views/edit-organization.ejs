<%- include('partials/header', { title }) %>
<main id="main-content">
    <section class="directory-section">
        <div class="content-width">
            <div class="form-panel">
                <p class="eyebrow">Community partner</p>
                <h1><%= title %></h1>
                <form class="data-form" action="/edit-organization/<%= organization.organization_id %>" method="POST">
                    <div class="form-field">
                        <label for="name">Organization Name</label>
                        <input type="text" id="name" name="name" value="<%= organization.name %>" maxlength="150" required>
                    </div>
                    <div class="form-field">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" maxlength="1000" rows="5" required><%= organization.description %></textarea>
                    </div>
                    <div class="form-field">
                        <label for="contactEmail">Contact Email</label>
                        <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email %>" maxlength="255" required>
                    </div>
                    <div class="form-field">
                        <label for="logoFilename">Logo Filename</label>
                        <input type="text" id="logoFilename" name="logoFilename" value="<%= organization.logo_filename %>" maxlength="255" required>
                        <p class="field-help">Enter a filename from the site's public/images folder.</p>
                    </div>
                    <div class="form-actions">
                        <button class="button button-primary" type="submit">Save changes</button>
                        <a class="text-link" href="/organization/<%= organization.organization_id %>">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </section>
</main>
<%- include('partials/footer') %>
